{
  "info": {
    "name": "Lab12 Authors Excursions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:18000"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Database ready\",()=>pm.expect(pm.response.json().database).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create excursion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/excursions",
        "body": {
          "mode": "raw",
          "raw": "{\"city\": \"{{runCity}}\", \"title\": \"{{runTitle}}\", \"description\": \"Проверка из Postman\", \"persons_count\": 5, \"has_children\": true, \"date\": \"{{futureDate}}\", \"status\": \"change\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runTitle\", \"Postman \" + pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.set(\"runCity\", \"Lab12-\" + pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0,20));",
              "pm.collectionVariables.set(\"futureDate\", new Date(Date.now()+30*86400000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"excursionId\",pm.response.json().id);",
              "pm.test(\"Positive id\",()=>pm.expect(pm.response.json().id).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List excursions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/excursions?city={{runCity}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Created item listed\",()=>pm.expect(pm.response.json().some(e=>e.id===Number(pm.collectionVariables.get(\"excursionId\")))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Read by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/excursions/{{excursionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
