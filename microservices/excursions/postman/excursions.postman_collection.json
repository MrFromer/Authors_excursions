            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Error message\", () => { const e=pm.response.json().error; pm.expect(e.code).to.be.a(\"string\"); pm.expect(e.message).to.be.a(\"string\").and.not.empty; });"
            ]
          }
        }
      ]
    },
